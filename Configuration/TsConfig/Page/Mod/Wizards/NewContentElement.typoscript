mod.wizards.newContentElement.wizardItems {
    common.elements {
        slideshow {
            iconIdentifier = t3upslideshow_content
            title = LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_backend.xlf:slideshow.title
            description = LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_backend.xlf:slideshow.description
            tt_content_defValues {
                CType = t3upslideshow_content
            }
        }  
    }
    common.show := addToList(slideshow)
}
