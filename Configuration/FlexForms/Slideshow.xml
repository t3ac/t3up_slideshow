<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>
    <sheets>
		<scontrols>
            <ROOT type="array">
                    <sheetTitle>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:sheet.controls</sheetTitle>
                <type>array</type>
                <el type="array">                    
                    <animation type="array">
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.animation</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items type="array">
                                    <numIndex index="0" type="array">
                                        <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.animation.1</label>
                                        <value></value>
                                    </numIndex>
                                    <numIndex index="1" type="array">
                                        <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.animation.2</label>
                                        <value>carousel-fade</value>
                                    </numIndex>
                                </items>
                            </config>
                    </animation>  
                    
                    <imageformat>
                        <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.format</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0" type="array">
                                    <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.format0</label>
                                    <value>0</value>
                                </numIndex>  
                                <numIndex index="1" type="array">
                                    <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.format1</label>
                                    <value>1</value>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.format2</label>
                                    <value>2</value>
                                </numIndex>    
                                <numIndex index="3" type="array">
                                    <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.format3</label>
                                    <value>3</value>
                                </numIndex>  
                                <numIndex index="4" type="array">
                                    <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.format4</label>
                                    <value>4</value>
                                </numIndex>
                                <numIndex index="5" type="array">
                                    <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.format5</label>
                                    <value>5</value>
                                </numIndex>
                                <numIndex index="6" type="array">
                                    <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.format6</label>
                                    <value>6</value>
                                </numIndex>                            
                            </items>
                            <default>3</default>
                        </config>
                    </imageformat>
    	
                    <controlNav type="array">
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.controlNav</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items type="array">
                                    <numIndex index="0" type="array">
                                        <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.no</label>
                                        <value>false</value>
                                    </numIndex>               	
                                    <numIndex index="1" type="array">
                                        <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.yes</label>
                                        <value>true</value>
                                    </numIndex>
                                </items>
                                <default>true</default>
                            </config>
                    </controlNav>
                    
                    <directionNav type="array">
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.directionNav</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items type="array">
                                    <numIndex index="0" type="array">
                                        <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.no</label>
                                        <value>false</value>
                                    </numIndex>
                                    <numIndex index="1" type="array">
                                        <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.yes</label>
                                        <value>true</value>
                                    </numIndex>
                                </items>
                                <default>true</default>
                            </config>
                    </directionNav>
                    
                    <slideshowSpeed type="array">
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.slideshowSpeed</label>
				<config>
			    <type>input</type>
			    <size>3</size>
			    <default>4000</default>
			    <eval>int</eval>
			    <range>
				<lower>500</lower>
				<upper>20000</upper>
			    </range>
			    <wizards>
				<slideshow>
				    <type>slider</type>
				    <step>100</step>
				</slideshow>
			    </wizards>
			</config>    
                    </slideshowSpeed>           
                </el>
            </ROOT>
        </scontrols>
        <soptions>
            <ROOT type="array">
                <sheetTitle>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:sheet.options</sheetTitle>
                <type>array</type>
                <el type="array">
                    <captionshow>
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.captionshow</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items type="array">
                                    <numIndex index="0" type="array">
                                        <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.no</label>
                                        <value>false</value>
                                    </numIndex>
                                    <numIndex index="1" type="array">
                                        <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:label.yes</label>
                                        <value>true</value>
                                    </numIndex>
                                </items>
                                <default>false</default>
                            </config>
                    </captionshow>          
                	<captionbackgroundcolor>
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.captionbg</label>
                             <config>
                                <type>input</type> 
					<size>6</size> 
					<renderType>colorpicker</renderType>
					<default>#000000</default> 
                            </config>
                    </captionbackgroundcolor>    
                	<captioncolor>
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.captionColor</label>
                             <config>
                                <type>input</type> 
					<size>6</size> 
					<renderType>colorpicker</renderType>
					<default>#ffffff</default> 
                            </config>
                	</captioncolor> 
                	<captionopacity>
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.captionOpacity</label>
				<config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items type="array">
                                    <numIndex index="1" type="array">
                                        <label>0 transparent</label>
                                        <value>0</value>
                                    </numIndex>
                                    <numIndex index="2" type="array">
                                        <label>1</label>
                                        <value>1</value>
                                    </numIndex>
                                    <numIndex index="3" type="array">
                                        <label>2</label>
                                        <value>2</value>
                                    </numIndex>
                                    <numIndex index="4" type="array">
                                        <label>3 - 25%</label>
                                        <value>3</value>
                                    </numIndex>
                                    <numIndex index="5" type="array">
                                        <label>4</label>
                                        <value>4</value>
                                    </numIndex>
                                    <numIndex index="6" type="array">
                                        <label>56</label>
                                        <value>5</value>
                                    </numIndex> 
                                    <numIndex index="7" type="array">
                                        <label>6</label>
                                        <value>6</value>
                                    </numIndex>
                                    <numIndex index="8" type="array">
                                        <label>7 - 50%</label>
                                        <value>7</value>
                                    </numIndex>
                                    <numIndex index="9" type="array">
                                        <label>8</label>
                                        <value>8</value>
                                    </numIndex>
                                    <numIndex index="10" type="array">
                                        <label>9</label>
                                        <value>9</value>
                                    </numIndex>
                                    <numIndex index="11" type="array">
                                        <label>10</label>
                                        <value>a</value>
                                    </numIndex>
                                    <numIndex index="12" type="array">
                                        <label>11 - 75%</label>
                                        <value>b</value>
                                    </numIndex>
                                    <numIndex index="13" type="array">
                                        <label>12</label>
                                        <value>c</value>
                                    </numIndex>                          
                                    <numIndex index="14" type="array">
                                        <label>13</label>
                                        <value>d</value>
                                    </numIndex>
                                    <numIndex index="15" type="array">
                                        <label>14</label>
                                        <value>e</value>
                                    </numIndex>
                                    <numIndex index="16" type="array">
                                        <label>15 - 100%</label>
                                        <value>f</value>
                                    </numIndex>                                            
                                </items>
                                <default>b</default>
                            </config> 
                	</captionopacity> 	
                	<textalign>
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.textalign</label>
							<config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items type="array">
                                     <numIndex index="14" type="array">
                                        <label>left</label>
                                        <value>left</value>
                                    </numIndex>
                                    <numIndex index="15" type="array">
                                        <label>center</label>
                                        <value>center</value>
                                    </numIndex>
                                    <numIndex index="16" type="array">
                                        <label>right</label>
                                        <value>right</value>
                                    </numIndex>                                            
                                </items>
                            </config> 
                	</textalign>          	
                	<slideshowoverlaycolor>
                            <label>LLL:EXT:t3up_slideshow/Resources/Private/Language/locallang_flexform.xlf:slideshow.slideshowoverlaycolor</label>
                             <config>
                                <type>input</type> 
								<size>6</size> 
								<renderType>colorpicker</renderType>
								<default></default> 
                            </config>
                	</slideshowoverlaycolor>  	
                </el>                	
            </ROOT>
        </soptions>
    </sheets>
</T3DataStructure>
